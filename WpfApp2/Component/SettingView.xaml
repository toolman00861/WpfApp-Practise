<UserControl x:Class="WpfApp2.Component.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WpfApp2.Component"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <!--
        WPF 默认没有 CSS 的 gap：Grid 行、StackPanel 子项都会贴在一起。
        用 Margin 留空，用 VerticalAlignment 让文字和输入框齐平。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="阈值设置"
                   FontSize="24"
                   FontWeight="SemiBold"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,0">
            <TextBlock Text="电压最小值"
                       Width="80"
                       VerticalAlignment="Center"/>
            <TextBox 
                x:Name="MinVoltage"
                Width="100"
                     Margin="12,0,0,0"
                     Padding="4"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <TextBlock 
                    Text="电压最大值"
                    Width="80"
                    VerticalAlignment="Center"/>
            <TextBox 
                x:Name="MaxVoltage"
                Width="100"
                     Margin="12,0,0,0"
                     Padding="4"
                     VerticalContentAlignment="Center"/>
        </StackPanel>
        <Button Grid.Row="3"
                HorizontalAlignment="Left"
                Margin="0,20,0,0"
                Padding="16,6"
                Content="保存"
                Click="SaveButton_Click"/>
    </Grid>
</UserControl>
