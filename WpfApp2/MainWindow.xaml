<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="电芯检测 — 表单与表格"
        Height="560"
        Width="900">
    <!--
        主窗口只当「外壳」：上面换页按钮，中间 ContentControl 装当前页。
        这和网页里 <router-view> 是同一个思路。
        两个页是 UserControl，所以用 ContentControl.Content = 某个控件。
        如果页是 Page，则改用 Frame + Navigate()。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="20,16,20,8">
            <Button x:Name="JudgeNavButton"
                    Content="判定录入"
                    Padding="16,6"
                    Click="JudgeNavButton_Click"/>
            <Button x:Name="RecordNavButton"
                    Content="检测记录"
                    Padding="16,6"
                    Margin="8,0,0,0"
                    Click="RecordNavButton_Click"/>
            <Button x:Name="SettingNavButton"
                    Content="设置"
                    Padding="16,6"
                    Margin="8,0,0,0"
                    Click="SettingNavButton_Click"/>
            <!-- 练习 22：Modbus 握手。页是 HSLTest，逻辑在 HslService。 -->
            <Button x:Name="HslNavButton"
                    Content="HSL 练习"
                    Padding="16,6"
                    Margin="8,0,0,0"
                    Click="HslNavButton_Click"/>
        </StackPanel>

        <!-- 换页容器：同一时刻只显示一个 UserControl -->
        <ContentControl x:Name="PageHost"
                        Grid.Row="1"
                        Margin="20,8,20,8"/>

        <TextBlock Grid.Row="2"
                   Margin="20,0,20,16"
                   Foreground="Gray"
                   Text="{Binding StatusMessage}"/>
    </Grid>
</Window>
